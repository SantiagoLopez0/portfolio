---
/**
 * Contact + Footer (#contact). Wireframe: una sola pieza separada por una línea —
 * arriba disponibilidad, CTA (display-xl), correo y botones, centrados; abajo el footer
 * con marca, links, redes, ©, hora local y "Back to top".
 * Ajustes de Santiago (22 nov 2026):
 * - Fondo de contraste claro (#eaeaea, tokens del tema claro) frente al resto del sitio,
 *   que es negro.
 * - Esquinas superiores redondeadas: se ve como una tarjeta por encima de todo.
 * - Al llegar, la sección de arriba se mueve hacia abajo, por debajo de la tarjeta
 *   (src/scripts/closing-reveal.ts).
 * Va fuera de <main> para que <footer> sea el pie de la página (contentinfo).
 */
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
import { contact, footer } from '@/data/contact';

const year = new Date().getFullYear();
const emailHref = contact.email ? `mailto:${contact.email}` : '#contact';
const bookingHref = contact.secondaryCta.href || '#contact';
---

<div class="closing" data-theme="light" data-closing>
  <section id="contact" class="contact" aria-labelledby="contact-title" data-reveal>
    <div class="container contact__inner">
      <p class="contact__availability label" data-reveal-item="text">
        <span class="contact__dot" aria-hidden="true"></span>
        {contact.availability}
      </p>
      <h2 id="contact-title" class="contact__title" data-reveal-item="text">
        {contact.title}
      </h2>
      {/* La entrada va en un envoltorio: la transición de opacidad del hover chocaba con ella. */}
      <div data-reveal-item="slide">
        <a class="contact__email hover-fade" href={emailHref}>
          {contact.email || contact.emailPlaceholder}
        </a>
      </div>
      <div class="contact__actions" data-reveal-item="group">
        <Button href={emailHref}>{contact.primaryCta.label}</Button>
        <Button
          href={bookingHref}
          variant="outline"
          {...(contact.secondaryCta.href ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {contact.secondaryCta.label}
        </Button>
      </div>
    </div>
  </section>

  <footer class="container">
    <div class="footer">
      <div class="footer__top">
        <div class="footer__brand">
          <a class="footer__name hover-fade" href="#hero">
            {site.name}
          </a>
          <span class="footer__role">{footer.role}</span>
        </div>

        <nav class="footer__nav" aria-label="Footer">
          <ul role="list">
            {footer.nav.map((link) => (
              <li>
                <a class="label link-line" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <ul class="footer__socials" role="list" aria-label="Social">
          {footer.socials.map((social) => (
            <li>
              {social.href ? (
                <a class="label link-line" href={social.href} target="_blank" rel="noopener">
                  {social.label}
                </a>
              ) : (
                <span class="label">{social.label}</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__bottom">
        <span class="label">
          © {year} {site.name}
        </span>
        <span class="label">
          {footer.timeLabel} <time data-local-time={footer.timeZone}>--:--</time>
        </span>
        <a class="footer__top-link label link-line" href={footer.backToTop.href}>
          {footer.backToTop.label}
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 19V5M5 12l7-7 7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </footer>
</div>

<script>
  import { initClosingReveal } from '@/scripts/closing-reveal';
  import { initLocalTime } from '@/scripts/local-time';

  const card = document.querySelector<HTMLElement>('[data-closing]');
  if (card) initClosingReveal(card);
  document.querySelectorAll<HTMLTimeElement>('[data-local-time]').forEach(initLocalTime);
</script>

<style>
  .closing {
    /* Radio de la tarjeta: a escala de sección, el radius-lg (0.75rem) se pierde. */
    --closing-radius: 2rem;
    /* Fondo elegido por Santiago (22 nov 2026). */
    --surface-base: #eaeaea;

    position: relative;
    z-index: 1;
    border-radius: var(--closing-radius) var(--closing-radius) 0 0;
    background-color: var(--surface-base);
    color: var(--ink);
  }

  /* Contact: 120px arriba; bloque centrado con 32px entre piezas. */
  .contact {
    padding-top: var(--space-30);
  }

  .contact__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    text-align: center;
  }

  /* Estilo de link del nav (.label). Un tag no sirve aquí: es blanco translúcido y en
     el fondo claro no se vería. */
  .contact__availability {
    display: inline-flex;
    align-items: center;
    margin: 0;
  }

  /* inline-block: al dividir el texto en líneas (animación de entrada) deja de ser ítem flex. */
  .contact__dot {
    display: inline-block;
    margin-right: var(--space-2);
    vertical-align: 0.1em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .contact__title {
    max-width: 60rem;
    font: var(--text-display-xl);
    letter-spacing: -0.035em;
  }

  .contact__email {
    padding-bottom: var(--space-1);
    border-bottom: 1.5px solid currentColor;
    font: 500 1.5rem/1.3 var(--font-body);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* Footer: 96px bajo el contacto, línea arriba (al ancho del contenido), 40px de aire. */
  .footer {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: var(--space-24);
    padding-top: 2.5rem;
    padding-bottom: var(--space-12);
    border-top: 1px solid var(--line);
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__role {
    font: var(--text-body-sm);
    color: var(--ink-muted);
  }

  .footer__nav ul,
  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-8);
    margin: 0;
  }

  .footer__socials {
    gap: var(--space-4);
  }

  /* Todo el texto como "Back to top" (.label, ink). */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
  }

  .footer__top-link svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  /* Mobile (≤ 768px). */
  @media (max-width: 768px) {
    .closing {
      --closing-radius: 1.25rem;
    }

    .contact__inner {
      gap: var(--space-6);
    }

    .contact__email {
      font-size: 1.25rem;
    }

    /* Botones uno debajo del otro. */
    .contact__actions {
      flex-direction: column;
      align-items: center;
    }

    /* Footer en columna: nombre, links, redes y al final ©, hora y Back to top. */
    .footer {
      gap: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .footer__top {
      flex-direction: column;
      gap: var(--space-6);
    }

    .footer__nav ul {
      gap: var(--space-4) var(--space-6);
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
