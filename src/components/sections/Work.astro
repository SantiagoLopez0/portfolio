---
/**
 * Selected work (#work). Wireframe: H2 + 4 WorkCard a ancho completo, cada una abre su
 * popup de case study. Ajustes de Santiago (22 nov 2026): fondo oscuro como todo el sitio,
 * título centrado sin conteo, y cards que se apilan al hacer scroll (sticky + escala con
 * GSAP ScrollTrigger, ver src/scripts/work-stack.ts).
 * Contenido desde Sanity (`project`); mientras no haya proyectos publicados, placeholders.
 */
import WorkCard from '@/components/ui/WorkCard.astro';
import CaseStudy from '@/components/ui/CaseStudy.astro';
import { getSelectedWork } from '@/lib/work';

const { items } = await getSelectedWork();
const dialogId = (slug: string) => `case-${slug}`;
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="container">
    <h2 id="work-title" class="work__title" data-reveal-item="text">
      Selected work
    </h2>

    <div class="work__list" data-work-stack data-reveal-item="group">
      {items.map((item, index) => (
        <WorkCard item={item} index={index} dialogId={dialogId(item.slug)} />
      ))}
    </div>
  </div>

  {items.map((item) => (
    <CaseStudy item={item} id={dialogId(item.slug)} />
  ))}
</section>

<script>
  import { initCaseStudies } from '@/scripts/case-study';
  import { initWorkStack } from '@/scripts/work-stack';

  const section = document.getElementById('work');
  const list = section?.querySelector<HTMLElement>('[data-work-stack]');
  if (section) initCaseStudies(section);
  if (list) initWorkStack(list);
</script>

<style>
  .work {
    /* 56px entre cards (WorkCard README); no hay token de 3.5rem. */
    --work-gap: 3.5rem;
    /* Título → cards: los mismos 56px menos un 10% (ajuste de Santiago). */
    --work-title-gap: calc(var(--work-gap) * 0.9);
    /* Pila: dónde se pegan las cards (todas en el mismo punto). */
    --stack-top: calc(var(--header-height) + var(--space-8));

    padding-block: var(--space-30) var(--space-24);
    background-color: var(--surface-base);
    color: var(--ink);
  }

  .work__title {
    margin-bottom: var(--work-title-gap);
    font: var(--text-h2);
    letter-spacing: -0.025em;
    text-align: center;
  }

  .work__list {
    display: flex;
    flex-direction: column;
    gap: var(--work-gap);
  }

  /* Cards apiladas: todas se pegan en el mismo punto; la que llega tapa por completo a la
     anterior, que se encoge detrás (work-stack.ts). Sin franjas a la vista: la atención
     queda en la card activa (ajuste de Santiago, 22 nov 2026). */
  @media (prefers-reduced-motion: no-preference) {
    .work__list > :global(.work-card) {
      position: sticky;
      top: var(--stack-top);
    }
  }

  /* Mobile (≤ 768px). */
  @media (max-width: 768px) {
    .work {
      --work-gap: var(--space-8);
      --stack-top: calc(var(--header-height) + var(--space-4));
    }
  }
</style>

<style is:global>
  /* Sin Lenis (reduced motion) la página de atrás tampoco debe moverse con un popup abierto. */
  html:has(dialog.case[open]) {
    overflow: hidden;
  }
</style>
