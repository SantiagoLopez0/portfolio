---
/**
 * What I do (#services), componente ServiceList del design system: lista grande a la
 * derecha y, a la izquierda, el nombre y la descripción de la opción activa.
 * - La opción activa cambia con hover (mouse), con clic o tap (touch) y con el teclado.
 *   La primera es la activa por defecto. Al salir de la lista se queda la última.
 * - Ajuste de Santiago (22 nov 2026): títulos de la lista en `ink` (2.75rem) con opacidad 0.6; la
 *   activa (o la que está bajo el mouse) a opacidad 1.
 * - Semántica de pestañas (tablist / tab / tabpanel): las 5 descripciones están en el HTML
 *   y el texto de la izquierda es el panel de la pestaña activa.
 */
import { services, servicesTitle } from '@/data/services';

const id = (index: number, part: 'tab' | 'panel') => `service-${part}-${index + 1}`;
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<section id="services" class="services" aria-labelledby="services-title">
  <div class="container services__inner" data-services>
    <h2 id="services-title" class="visually-hidden">
      {servicesTitle}
    </h2>

    <div class="services__detail">
      {services.map((service, index) => (
        <div
          id={id(index, 'panel')}
          class="services__panel"
          role="tabpanel"
          aria-labelledby={id(index, 'tab')}
          hidden={index !== 0}
          data-service-panel
        >
          <p class="services__name label" data-reveal-item={index === 0 ? 'text' : undefined}>
            {service.name}
          </p>
          <p class="services__description" data-reveal-item={index === 0 ? 'text' : undefined}>
            {service.description}
          </p>
        </div>
      ))}
    </div>

    <div
      class="services__list"
      role="tablist"
      aria-label={servicesTitle}
      aria-orientation="vertical"
    >
      {services.map((service, index) => (
        <button
          id={id(index, 'tab')}
          class="services__item"
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={id(index, 'panel')}
          tabindex={index === 0 ? 0 : -1}
          data-service-tab
        >
          <span class="services__label" data-reveal-item="text">
            {service.name}
          </span>
          <span class="services__index" aria-hidden="true">
            ( {number(index)} )
          </span>
        </button>
      ))}
    </div>

    <!-- Mobile: todos los servicios abiertos, sin interacción (pedido de Santiago). -->
    <ul class="services__mobile" role="list">
      {services.map((service, index) => (
        <li class="services__mobile-item">
          <h3 class="services__mobile-name" data-reveal-item="text">
            {service.name}
            <span class="services__index" aria-hidden="true">
              ( {number(index)} )
            </span>
          </h3>
          <p class="services__mobile-description" data-reveal-item="text">
            {service.description}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { initServiceList } from '@/scripts/service-list';

  const root = document.querySelector<HTMLElement>('#services [data-services]');
  if (root) initServiceList(root);
</script>

<style>
  .services {
    padding-block: var(--space-24) var(--space-30);
    background-color: var(--surface-base);
    color: var(--ink);
  }

  /* Columna de texto de 24rem y separación de space-16 × 2.15 (ajustes de Santiago sobre
     los 320px y 64px del wireframe). */
  .services__inner {
    display: flex;
    gap: calc(var(--space-16) * 2.15);
  }

  .services__detail {
    flex: 0 0 24rem;
    min-width: 0;
    padding-top: var(--space-6);
  }

  .services__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .services__panel[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .services__panel {
      animation: services-panel-in 0.35s ease both;
    }
  }

  @keyframes services-panel-in {
    from {
      opacity: 0;
      transform: translateY(var(--space-2));
    }
  }

  /* Estilo de los links del nav (.label: mayúsculas, 700, 0.75rem), en ink-muted. */
  .services__name {
    margin: 0;
    color: var(--ink-muted);
  }

  .services__description {
    margin: 0;
    font: var(--text-body-lg);
  }

  .services__list {
    flex: 1 1 40rem;
    min-width: 0;
    border-top: 1px solid var(--line);
  }

  .services__item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    width: 100%;
    padding: 1.25rem 0 var(--space-6);
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--ink);
    text-align: start;
    cursor: pointer;
  }

  /* Ajustes de Santiago: 2.75rem; 0.6 en reposo; la activa y la que está bajo el mouse a
     opacidad 1 y se corren 16px a la derecha. */
  .services__label {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    opacity: 0.6;
    transition:
      opacity 0.2s,
      padding 0.3s ease;
  }

  .services__item:hover .services__label,
  .services__item[aria-selected='true'] .services__label {
    padding-inline-start: 1rem;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .services__label {
      transition: opacity 0.2s;
    }
  }

  .services__index {
    margin-top: 0.625rem;
    font: var(--text-body-sm);
    font-weight: 600;
    color: var(--ink-muted);
    white-space: nowrap;
    transition: color 0.2s;
  }

  /* Design system: el índice de la fila activa va en accent (uno de los pocos puntos azules). */
  .services__item[aria-selected='true'] .services__index {
    color: var(--accent);
  }

  .services__mobile {
    display: none;
  }

  .services__item:focus-visible {
    outline-offset: -2px;
  }

  /* Mobile (≤ 768px). */
  @media (max-width: 768px) {
    /* En mobile no hay pestañas: la lista completa, cada servicio con su descripción. */
    .services__detail,
    .services__list {
      display: none;
    }

    .services__mobile {
      display: block;
      width: 100%;
      margin: 0;
      border-top: 1px solid var(--line);
    }

    .services__mobile-item {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-block: var(--space-6);
      border-bottom: 1px solid var(--line);
    }

    .services__mobile-name {
      display: flex;
      align-items: flex-start;
      gap: 0.875rem;
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .services__mobile-name .services__index {
      margin-top: 0.25rem;
      letter-spacing: 0;
    }

    .services__mobile-description {
      margin: 0;
      font: var(--text-body);
      color: var(--ink-muted);
    }
  }

  /* Tablet (769–1024px): columnas más angostas para que la de la derecha tenga aire. */
  @media (min-width: 769px) and (max-width: 1024px) {
    .services__inner {
      gap: var(--space-16);
    }

    .services__detail {
      flex-basis: 17rem;
    }
  }
</style>
