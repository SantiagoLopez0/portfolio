---
/**
 * FAQ (#faq). Wireframe: H2 + intro + botón a Contact a la izquierda y 6 preguntas en
 * acordeón a la derecha (FaqItem del design system). Fondo oscuro como el resto del sitio.
 * Ajustes de Santiago (22 nov 2026):
 * - Columnas iguales a What I do: izquierda de 24rem y separación de space-16 × 2.15.
 * - Cada pregunta se abre y cierra por su cuenta, con animación suave; todas cerradas
 *   al cargar. Lógica en src/scripts/faq.ts.
 */
import Button from '@/components/ui/Button.astro';
import { faq } from '@/data/faq';

const id = (index: number, part: 'question' | 'answer') => `faq-${part}-${index + 1}`;
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="container faq__inner">
    <div class="faq__intro">
      <h2 id="faq-title" class="faq__title">
        {faq.title}
      </h2>
      <p class="faq__lead">{faq.intro}</p>
      <div>
        <Button href={faq.cta.href} variant="outline-bold">
          {faq.cta.label}
        </Button>
      </div>
    </div>

    <div class="faq__list" data-faq>
      {faq.items.map((item, index) => (
        <div class="faq__item" data-faq-item>
          <h3 class="faq__heading">
            <button
              id={id(index, 'question')}
              class="faq__question"
              type="button"
              aria-expanded="false"
              aria-controls={id(index, 'answer')}
              data-faq-toggle
            >
              <span>{item.question}</span>
              <svg
                class="faq__icon"
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path class="faq__icon-vertical" d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
            </button>
          </h3>
          <div
            id={id(index, 'answer')}
            class="faq__answer"
            role="region"
            aria-labelledby={id(index, 'question')}
          >
            <div class="faq__answer-inner">
              <p class="faq__answer-text">{item.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { initFaq } from '@/scripts/faq';

  const list = document.querySelector<HTMLElement>('#faq [data-faq]');
  if (list) initFaq(list);
</script>

<style>
  .faq {
    padding-block: var(--space-24) var(--space-30);
    background-color: var(--surface-base);
    color: var(--ink);
  }

  /* Mismas columnas que What I do (Services.astro). */
  .faq__inner {
    display: flex;
    gap: calc(var(--space-16) * 2.15);
  }

  .faq__intro {
    flex: 0 0 24rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .faq__title {
    font: var(--text-h2);
    letter-spacing: -0.025em;
  }

  .faq__lead {
    margin: 0;
    max-width: 20rem;
    font: var(--text-body);
    color: var(--ink-muted);
  }

  .faq__list {
    flex: 1 1 40rem;
    min-width: 0;
    border-top: 1px solid var(--ink);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__heading {
    font: var(--text-h4);
    letter-spacing: -0.015em;
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    width: 100%;
    padding: 1.75rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .faq__question:hover {
    opacity: var(--hover-opacity);
  }

  .faq__icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Más → menos: la línea vertical se encoge al abrir. */
  .faq__icon-vertical {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.35s ease;
  }

  .faq__item[data-open] .faq__icon-vertical {
    transform: scaleY(0);
  }

  /* Abrir y cerrar con altura animada: la fila del grid va de 0fr a 1fr. Cerrada queda
     con visibility: hidden (fuera del árbol de accesibilidad y del foco), al terminar. */
  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s 0.45s;
  }

  .faq__item[data-open] .faq__answer {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s;
  }

  .faq__answer-inner {
    min-height: 0;
    overflow: hidden;
  }

  .faq__answer-text {
    max-width: 32.5rem;
    margin: 0;
    padding-bottom: 1.75rem;
    font: var(--text-body);
    color: var(--ink-muted);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .faq__item[data-open] .faq__answer-text {
    opacity: 1;
    transition-delay: 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__answer,
    .faq__item[data-open] .faq__answer,
    .faq__answer-text,
    .faq__icon-vertical {
      transition: none;
    }
  }

  /* Mobile (≤ 768px). */
  @media (max-width: 768px) {
    /* Título, intro y botón arriba; preguntas abajo; poco espaciado. */
    .faq__inner {
      flex-direction: column;
      gap: var(--space-8);
    }

    .faq__intro {
      flex: none;
      gap: var(--space-4);
    }

    .faq__list {
      flex: none;
    }

    .faq__question {
      padding: 1.25rem 0;
    }

    .faq__answer-text {
      padding-bottom: 1.25rem;
    }
  }
</style>
