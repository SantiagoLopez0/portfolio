---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import Logos from '@/components/sections/Logos.astro';
import Work from '@/components/sections/Work.astro';
import Services from '@/components/sections/Services.astro';
import Process from '@/components/sections/Process.astro';
import { showProcess } from '@/data/process';
import About from '@/components/sections/About.astro';
import Faq from '@/components/sections/Faq.astro';
import Contact from '@/components/sections/Contact.astro';
import { site } from '@/data/site';
---

<BaseLayout title={`${site.name} — Portfolio`}>
  <Header />
  <main>
    <Hero />
    <Logos />
    <Work />
    <Services />
    {showProcess && <Process />}
    <About />
    <Faq />
  </main>
  <Contact />
</BaseLayout>
