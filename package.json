{
  "name": "santiago-lopez-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter studio dev",
    "dev:web": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "pnpm --filter web build",
    "build:studio": "pnpm --filter studio build",
    "preview": "pnpm --filter web preview",
    "check": "pnpm --filter web check",
    "typegen": "pnpm --filter studio typegen",
    "deploy:studio": "pnpm --filter studio deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2"
  }
}
